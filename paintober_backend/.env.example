SECRET_KEY=your-strong-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-api-domain.com
CORS_ALLOWED_ORIGINS=https://paintober.netlify.app
CSRF_TRUSTED_ORIGINS=https://paintober.netlify.app

# Database — omit or set to sqlite3 for local dev
DB_ENGINE=django.db.backends.postgresql
DB_NAME=paintoberdb
DB_USER=djangouser
DB_PASSWORD=djangopass0!
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Production HTTPS security (set to True once HTTPS is active at your host)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SECURE=True

# Image storage. Set GCS_ENABLED=True in production to store new job inputs
# and outputs in Google Cloud Storage. The Google client reads credentials from
# GOOGLE_APPLICATION_CREDENTIALS or the deployment environment.
GCS_ENABLED=False
GCS_UPLOAD_BUCKET_NAME=
GCS_RESULTS_BUCKET_NAME=
GCS_PROJECT_ID=
GCS_OBJECT_PREFIX=jobs
GCS_SIGNED_URL_EXPIRY_SECONDS=3600
